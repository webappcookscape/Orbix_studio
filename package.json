{
  "name": "orbix-studio-cad",
  "version": "1.0.0",
  "description": "Orbix Studio — 3D Interior Cupboard CAD & Production Planning with PostgreSQL and Prisma",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "start:desktop": "electron electron-main.js",
    "package:win": "electron-packager . \"OrbixStudio\" --platform=win32 --arch=x64 --out=dist-desktop --overwrite --ignore=\"dist-desktop\"",
    "dist:win": "electron-builder --win --x64",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "build": {
    "appId": "com.orbixstudio.cad",
    "productName": "Orbix Studio CAD",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-packager": "^17.1.2"
  }
}
